{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veritas",
  "pages_build_output_dir": "dist/spa",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "VERITAS_DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET"
    }
  ],
  "observability": {
    "enabled": true
  }
}
