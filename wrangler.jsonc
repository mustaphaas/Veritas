{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veritas",
  "main": "./worker/entry.js",
  "compatibility_date": "2026-08-22",
  "keep_vars": true,
  "build": {
    "command": "npm run build:client"
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.7-flash",
    "GEMINI_MODEL_FALLBACKS": "gemini-3.6-flash,gemini-3.5-flash"
  },
  // NASA_EARTHDATA_TOKEN is intentionally NOT stored in Wrangler vars.
  // The VIIRS refresh workflow reads it from the GitHub Actions secret
  // named NASA_EARTHDATA_TOKEN so the credential never enters source control.
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "assets": {
    "directory": "./dist/spa",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veritas-production",
      "database_id": "abe5f8ae-ba0e-4d9e-b694-6380c6649f23",
      "migrations_dir": "migrations"
    }
  ]
}
