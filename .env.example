# Firebase Web API keys identify the project; they are not server secrets.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
# Optional until Firebase App Check is configured with reCAPTCHA Enterprise.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
