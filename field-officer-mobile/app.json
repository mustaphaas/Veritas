{
  "expo": {
    "name": "Veritas Field Officer",
    "slug": "veritas-field-officer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/rea-logo.png",
    "scheme": "veritas-field",
    "splash": {
      "image": "./assets/rea-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4faf6"
    },
    "android": {
      "package": "ng.gov.rea.veritas.fieldofficer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/rea-logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Veritas uses your location to verify that you have arrived at the assigned project site."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Veritas uses project photos as inspection evidence.",
          "cameraPermission": "Veritas uses the camera to capture project photo and video evidence.",
          "microphonePermission": "Veritas uses the microphone when recording project video evidence."
        }
      ],
      "expo-font",
      "expo-navigation-bar"
    ],
    "androidStatusBar": {
      "hidden": true,
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "apiBaseUrl": "https://veritas.mustaphaaliyu236.workers.dev/api",
      "eas": {
        "projectId": "f66faeee-9d38-428f-b773-f72d71b8d8bb"
      }
    }
  }
}
